{
  "name": "threatscope-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @threatscope/frontend --",
    "build": "npm run build --workspace @threatscope/frontend --",
    "test": "npm run test --workspace @threatscope/frontend --",
    "test:e2e": "npm run test:e2e --workspace @threatscope/frontend --",
    "preview": "npm run preview --workspace @threatscope/frontend --",
    "typecheck": "npm run typecheck --workspace @threatscope/frontend --",
    "lint": "eslint frontend/src frontend/vite.config.ts frontend/playwright.config.ts frontend/tests eslint.config.js --max-warnings 0",
    "format": "prettier --write frontend eslint.config.js",
    "format:check": "prettier --check frontend eslint.config.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript-eslint": "^8.73.0"
  }
}
