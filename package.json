{
    "name": "threatscope-workspace",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --host 127.0.0.1",
        "build": "tsc --noEmit && vite build",
        "test": "vitest run",
        "test:e2e": "playwright test",
        "preview": "vite preview --host 127.0.0.1",
        "lint": "eslint frontend/src vite.config.ts playwright.config.ts e2e eslint.config.js --max-warnings 0",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write frontend vite.config.ts playwright.config.ts e2e eslint.config.js",
        "format:check": "prettier --check frontend vite.config.ts playwright.config.ts e2e eslint.config.js"
    },
    "dependencies": {
        "@radix-ui/react-dialog": "^1.1.6",
        "@radix-ui/react-slot": "^1.1.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^0.468.0",
        "motion": "^12.0.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "recharts": "^3.0.0",
        "tailwind-merge": "^3.0.0"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.10.0",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.51.0",
        "@tailwindcss/vite": "^4.0.0",
        "@testing-library/jest-dom": "^8.0.0",
        "@testing-library/react": "^16.2.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^26.6.6",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "^6.3.0",
        "eslint": "^10.15.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.14.0",
        "jsdom": "^31.0.1",
        "prettier": "^3.10.1",
        "tailwindcss": "^4.0.0",
        "typescript": "~7.0.2",
        "typescript-eslint": "^8.73.0",
        "vite": "^8.3.8",
        "vitest": "^5.1.1"
    }
}
